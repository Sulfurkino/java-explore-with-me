						"body": {
							"mode": "raw",
							"raw": "{\n  \"annotation\": \"Annotation of the event for comments tests\",\n  \"category\": {{categoryId}},\n  \"description\": \"Description of the event for comments tests here\",\n  \"eventDate\": \"2035-12-01 12:00:00\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"paid\": false,\n  \"participantLimit\": 10,\n  \"requestModeration\": true,\n  \"title\": \"Comments test event\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/users/{{authorId}}/events"
					}
				},
				{
					"name": "Публикация события",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Event is published', function () {",
									"    pm.expect(pm.response.json().state).to.eql('PUBLISHED');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"stateAction\": \"PUBLISH_EVENT\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/admin/events/{{eventId}}"
					}
				},
