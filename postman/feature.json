		{
			"name": "Private comments",
			"item": [
				{
					"name": "Создание комментария",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Comment body has expected fields', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('id');",
									"    pm.expect(json).to.have.property('text');",
									"    pm.expect(json).to.have.property('eventId');",
									"    pm.expect(json).to.have.property('author');",
									"    pm.expect(json).to.have.property('created');",
									"    pm.expect(json.text).to.eql('Great event, I will definitely come');",
									"    pm.expect(json.eventId).to.eql(Number(pm.collectionVariables.get('eventId')));",
									"    pm.collectionVariables.set('commentId', json.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
