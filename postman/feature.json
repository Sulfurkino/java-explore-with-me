						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"annotation\": \"Annotation of unpublished event for comments\",\n  \"category\": {{categoryId}},\n  \"description\": \"Description of unpublished event for comments tests\",\n  \"eventDate\": \"2035-12-02 12:00:00\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"title\": \"Pending comments event\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
